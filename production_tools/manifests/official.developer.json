          },
          "phase": {
            "type": "string",
            "minLength": 0,
            "maxLength": 100
          },
          "available": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 0,
            "maxLength": 200
          },
          "binary": {
            "type": "string",
            "minLength": 0,
            "maxLength": 32760
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "side_effects": [
        "EXECUTE_CODE"
      ],
      "risk_level": "high",
      "permission_requirements": [
        "EXECUTE_CODE"
      ],
      "allowed_scope_types": [
        "tools_workspaces",
        "explicit_user_workspace"
      ],
      "timeout": 45,
      "verifier_type": "CODE"
    },
    "developer.test": {
      "id": "developer.test",
      "enabled": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
