{
  "tool_id": "official.document",
  "name": "DocumentTool",
  "version": "1.0.0",
  "category": "document",
  "description": "Creates and reads TXT, Markdown, DOCX and simple PDF documents in authorized scopes.",
  "capabilities": [
    "document.create_txt",
    "document.create_markdown",
    "document.create_docx",
    "document.read_document",
    "document.edit_document",
    "document.create_pdf"
  ],
  "input_schema": {
    "type": "object"
  },
  "output_schema": {
    "type": "object"
  },
  "side_effects": [
    "filesystem_read",
    "filesystem_write"
  ],
  "risk_level": "medium",
  "permission_policy": {
    "READ": "allow_in_scope",
    "CREATE": "allow_in_scope",
    "EDIT": "allow_in_scope",
    "OVERWRITE": "confirm",
    "MOVE": "deny",
    "DELETE": "deny",
    "EXECUTE_CODE": "deny",
    "INSTALL_DEPENDENCY": "deny",
    "EXTERNAL_ACTION": "deny"
  },
  "dependencies": [],
  "timeout": 30,
  "filesystem_scope": [
    "authorized_workspace"
  ],
  "status": "AVAILABLE",
  "capability_contracts": {
    "document.create_txt": {
      "id": "document.create_txt",
      "enabled": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32760,
            "x-path-operation": "WRITE"
          },
          "content": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2000000
          },
          "title": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2000
          },
          "overwrite": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "content"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 0,
            "maxLength": 32760
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "format": {
            "enum": [
              "txt",
              "md",
              "docx",
              "pdf"
            ]
          }
        },
        "required": [
          "path",
          "bytes",
          "format"
        ],
        "additionalProperties": false
      },
      "side_effects": [
        "CREATE",
        "OVERWRITE"
      ],
      "risk_level": "medium",
      "permission_requirements": [
        "CREATE",
        "OVERWRITE"
      ],
      "allowed_scope_types": [
        "tools_workspaces",
        "explicit_user_workspace"
      ],
      "timeout": 30,
      "verifier_type": "DOCUMENT"
    },
