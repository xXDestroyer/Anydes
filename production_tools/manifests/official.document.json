    "document.edit_document": {
      "id": "document.edit_document",
      "enabled": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32760,
            "x-path-operation": "WRITE"
          },
          "old_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000000
          },
          "new_text": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2000000
          },
          "title": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2000
          },
          "document_edit_spec": {
            "type": "object",
            "properties": {
              "target_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32760,
                "x-path-operation": "WRITE"
              },
              "operation": {
                "enum": [
                  "APPEND_PARAGRAPH",
                  "PREPEND_PARAGRAPH",
                  "REPLACE_TEXT",
                  "INSERT_AFTER",
                  "INSERT_BEFORE"
                ]
              },
              "payload": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000000
              },
              "anchor": {
                "type": "string",
                "minLength": 0,
                "maxLength": 1000000
              },
              "preserve_structure": {
                "type": "boolean"
              }
            },
            "required": [
              "operation",
              "payload"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "old_text",
              "new_text"
            ],
            "not": {
              "required": [
                "document_edit_spec"
              ]
            }
          },
          {
            "required": [
              "document_edit_spec"
            ],
            "not": {
              "required": [
                "old_text"
              ]
            }
          }
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 0,
            "maxLength": 32760
          },
          "edited": {
            "type": "boolean"
          },
          "structural": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "edited"
        ],
        "additionalProperties": false
      },
      "side_effects": [
        "EDIT"
      ],
      "risk_level": "medium",
      "permission_requirements": [
        "EDIT"
      ],
      "allowed_scope_types": [
        "tools_workspaces",
        "explicit_user_workspace"
      ],
      "timeout": 30,
      "verifier_type": "DOCUMENT"
    },
